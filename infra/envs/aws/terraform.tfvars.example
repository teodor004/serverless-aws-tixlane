# Documentation only. deploy.yml supplies these as TF_VAR_* from GitHub environment
# "production" variables; never create a real terraform.tfvars here (.gitignore blocks it).
#
# GitHub variable            -> OpenTofu variable
# AWS_ACCOUNT_ID             -> aws_account_id
# OWNER                      -> owner
# WORKLOAD_BOUNDARY_ARN      -> permissions_boundary_arn   (bootstrap output)
# TF_STATE_KMS_KEY_ARN       -> state_kms_key_id           (bootstrap output, encryption.tofu)
# CORS_ALLOWED_ORIGINS       -> cors_allowed_origins       (HCL list, e.g. ["https://app.example.com"])
# ALERT_EMAIL                -> alert_email                (optional)

aws_account_id           = "123456789012" # AWS documentation placeholder, not a real account
owner                    = "teodor004"
permissions_boundary_arn = "arn:aws:iam::123456789012:policy/tixlane-prod-workload-boundary"
state_kms_key_id         = "arn:aws:kms:eu-central-1:123456789012:key/00000000-0000-0000-0000-000000000000"
cors_allowed_origins     = ["https://app.example.com"]
alert_email              = ""
