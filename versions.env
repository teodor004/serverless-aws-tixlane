# Single source of truth for tool versions, read by the Makefile and every workflow.
#
# Each value was confirmed against the tool's official release on 2026-10-13 and is logged in
# docs/VERIFICATION_LOG.md (IDs in brackets). Bump deliberately, re-verify, and update the log.
# scripts/check_versions.sh fails CI if a PIN_ME placeholder is ever reintroduced. Comments
# must stay on their own lines: workflows append KEY=value lines to $GITHUB_ENV verbatim.

# [V-008] OpenTofu GitHub release v1.13.1 (2026-10-01); satisfies "~> 1.13".
TOFU_VERSION=1.13.1
# [V-012] uv 0.13.0 (2026-10-09); generated uv.lock locally.
UV_VERSION=0.13.0
# [V-014] tflint v0.64.0 (2026-07-17); setup-tflint takes the v-prefixed tag.
TFLINT_VERSION=v0.64.0
# [V-016] Trivy 0.75.0 (2026-10-01), after advisory GHSA-69fq-xp46-6x23 (compromised 0.69.4).
TRIVY_VERSION=0.75.0
# [V-017] Checkov 3.3.29 (PyPI).
CHECKOV_VERSION=3.3.29
# [V-018] gitleaks 8.30.1; image ghcr.io/gitleaks/gitleaks:v8.30.1 exists.
GITLEAKS_VERSION=8.30.1
# [V-019] Infracost CLI 0.10.46 (2026-09-25).
INFRACOST_VERSION=0.10.46
# [V-020] k6 2.3.0 (2026-09-21).
K6_VERSION=2.3.0
